# This folder is the whole Arduino sketchbook. Only the car dashboard
# project is tracked; everything else (other sketches, libraries) is ignored.
/*
!/.gitignore
!/README.md

!/esp32_dash/
!/esp32_obd_test/
!/esp32_simple/
!/esp32_cvbs_test/
!/esp32_obd_rpm/
!/elm327_client/
!/uno_dash/
!/uno_tvout_test/
!/dash_preview_app/
!/dash_previews/
!/esp32_fpga_test/
!/esp32_shift_light_test/
!/esp32_fake_elm327/
!/fpga/

# FPGA: Quartus installers, build output, simulation output, vendor docs
/fpga/installers/
/fpga/docs/
/fpga/build.log
/fpga/projects/*/db/
/fpga/projects/*/incremental_db/
/fpga/projects/*/output_files/
/fpga/projects/*/compile.log
/fpga/projects/*/*.qws
/fpga/projects/*/sta_paths.tcl
/fpga/projects/sim/out/

# compiled output (desktop preview, Arduino IDE "Export Compiled Binary")
build/

.DS_Store

# validate.sh --images output
validate_out/
__pycache__/
